# Crusoe Cloud Managed Inference
CRUSOE_API_KEY=your-api-key-here
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1

# Model IDs on Crusoe
CRUSOE_ORCHESTRATOR_MODEL=nvidia/Nemotron-3-Super-120B-A12B-FP8
CRUSOE_AGENT_MODEL=nvidia/Nemotron-3-Nano-30B-A3B-FP8

# Simulation defaults
MAX_SIMULATED_AGENTS=20
MAX_SIMULATION_STEPS=50
